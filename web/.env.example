# Leave NEXT_PUBLIC_LAUNCHPAD_ADDRESS empty to run in DEMO mode (simulated market, fake HYPE).
# After deploying the contract, paste the values the deploy script prints:
NEXT_PUBLIC_LAUNCHPAD_ADDRESS=
NEXT_PUBLIC_DEPLOY_BLOCK=
NEXT_PUBLIC_CHAIN_ID=99801
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
NEXT_PUBLIC_EXPLORER_URL=https://explorer-elysium-testnet.t.conduit.xyz

# Optional: lets ANY mobile wallet connect by QR code (WalletConnect). Free ID from https://cloud.reown.com
NEXT_PUBLIC_WC_PROJECT_ID=
# Your site address (shown inside wallets when people connect)
NEXT_PUBLIC_SITE_URL=
